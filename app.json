{
  "expo": {
    "name": "PetStore",
    "slug": "pet-store-app",
    "version": "1.0.0",
    "scheme": "petstore",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PetStore necesita acceso a tus fotos para agregar imágenes a tus productos.",
          "cameraPermission": "PetStore necesita acceso a la cámara para fotografiar productos.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "android": {
      "package": "com.eli_borja.petstoreapp"
    }
  }
}
